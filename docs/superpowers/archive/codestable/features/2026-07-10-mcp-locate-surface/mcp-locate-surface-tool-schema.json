                  "enum": [
                    "ok",
                    "partial",
                    "no_result",
                    "backend_unavailable",
                    "timeout",
                    "cancelled"
                  ]
                },
                "repositoryRef": {
                  "type": "string",
                  "const": "local-repository"
                },
                "normalizedTerms": {
                  "readOnly": true,
                  "minItems": 1,
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "readOnly": true,
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1
                      },
                      "caseSensitive": {
                        "type": "boolean"
                      },
                      "redaction": {
                        "readOnly": true,
                        "type": "object",
                        "properties": {
                          "applied": {
                            "type": "boolean",
                            "const": true
                          },
                          "reasonCodes": {
                            "readOnly": true,
