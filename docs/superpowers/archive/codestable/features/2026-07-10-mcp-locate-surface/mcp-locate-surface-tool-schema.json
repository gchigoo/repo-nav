{
  "sdkVersion": "1.29.0",
  "tool": {
    "name": "repo_nav_locate",
    "title": "Locate repository evidence",
    "description": "Locate current, filesystem-verified source-of-truth evidence in a repository.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "readOnly": true,
      "type": "object",
      "properties": {
        "repoPath": {
          "type": "string",
          "minLength": 1,
          "description": "repoPath is a raw filesystem string preserved without NFKC/trim; runtime validation rejects NUL and values over 4096 UTF-8 bytes."
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "description": "Optional display-only question; when present must remain non-empty after NFKC/trim (max 4096 UTF-8 bytes). Omitted question does not affect search plan."
        },
        "terms": {
          "readOnly": true,
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "search term must remain non-empty after NFKC normalization and trimming; runtime validation limits it to 128 UTF-8 bytes."
          },
          "$comment": "Runtime validation limits all normalized positive terms to 1024 UTF-8 bytes in total."
        },
        "termCase": {
          "type": "string",
          "enum": [
            "sensitive",
            "insensitive",
            "smart"
          ]
        },
        "anchors": {
          "readOnly": true,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "symbol",
                  "file",
                  "table",
                  "route",
                  "term"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "anchor value must remain non-empty after NFKC normalization and trimming; runtime validation limits it to 512 UTF-8 bytes."
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false,
            "$comment": "Runtime validation rejects file-anchor backslashes, absolute paths, and repository escape; file values are preserved exactly."
          }
        },
        "layers": {
          "readOnly": true,
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "client",
              "server",
              "db",
              "test",
              "docs",
              "config",
              "unknown"
            ]
          }
        },
        "negativeTerms": {
          "readOnly": true,
          "minItems": 0,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "negative search term must remain non-empty after NFKC normalization and trimming; runtime validation limits it to 128 UTF-8 bytes."
          },
          "$comment": "Runtime validation limits all normalized negative terms to 1024 UTF-8 bytes in total."
        },
        "limits": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "maxFiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "maxConfirmed": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "maxCandidates": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 30000
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "repoPath",
        "terms"
      ],
      "additionalProperties": false,
      "$comment": "Runtime Zod validation additionally enforces a serialized input UTF-8 byte budget and cross-field refinements."
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
