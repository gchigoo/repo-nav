                            "minLength": 1
                          },
                          "lines": {
                            "readOnly": true,
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              },
                              {
                                "type": "integer",
                                "exclusiveMinimum": 0,
                                "maximum": 9007199254740991
                              }
                            ],
                            "minItems": 2,
                            "maxItems": 2,
                            "$comment": "Runtime Zod validation additionally requires the first line number to be less than or equal to the second."
                          },
                          "excerpt": {
                            "type": "string",
                            "minLength": 1
                          },
                          "redaction": {
                            "readOnly": true,
                            "type": "object",
                            "properties": {
                              "applied": {
                                "type": "boolean",
                                "const": true
                              },
                              "fields": {
                                "readOnly": true,
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "readOnly": true,
                                  "type": "object",
                                  "properties": {
                                    "field": {
                                      "type": "string",
                                      "enum": [
                                        "file",
                                        "symbol",
                                        "excerpt"
                                      ]
                                    },
                                    "reasonCodes": {
                                      "readOnly": true,
                                      "minItems": 1,
                                      "type": "array",
                                      "items": {
                                        "type": "string",
                                        "enum": [
                                          "SECRET_LIKE_VALUE",
                                          "CONNECTION_STRING",
                                          "PERSONAL_DATA",
                                          "BINARY_OR_OVERSIZED_CONTENT",
                                          "UNTRUSTED_CONTROL_CHARACTERS"
                                        ]
                                      },
                                      "uniqueItems": true
                                    }
                                  },
                                  "required": [
                                    "field",
                                    "reasonCodes"
                                  ],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": [
                              "applied",
                              "fields"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "file",
                          "resolvable",
                          "lines",
                          "excerpt"
                        ],
                        "additionalProperties": false
