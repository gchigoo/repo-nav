                      "provenance": {
                        "readOnly": true,
                        "type": "object",
                        "properties": {
                          "discoveredBy": {
                            "readOnly": true,
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "codegraph",
