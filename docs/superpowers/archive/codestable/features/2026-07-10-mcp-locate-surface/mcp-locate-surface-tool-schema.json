                                "CONNECTION_STRING",
                                "PERSONAL_DATA",
                                "BINARY_OR_OVERSIZED_CONTENT",
                                "UNTRUSTED_CONTROL_CHARACTERS"
                              ]
                            },
                            "uniqueItems": true
                          }
                        },
                        "required": [
                          "applied",
                          "reasonCodes"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "value",
                      "caseSensitive"
                    ],
                    "additionalProperties": false
                  }
                },
                "confirmed": {
                  "readOnly": true,
                  "maxItems": 20,
