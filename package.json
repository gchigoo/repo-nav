{
  "name": "repo-nav",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "description": "Deterministic repository evidence service for local MCP clients.",
  "license": "MIT",
  "packageManager": "npm@11.12.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backends": {
      "types": "./dist/backends.d.ts",
      "import": "./dist/backends.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "repo-nav-mcp": "dist/main.js",
    "repo-nav": "dist/cli/main.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "docs/getting-started-mcp.md",
    "docs/debug-cli.md",
    "docs/reference/repo-nav-locate.md",
    "docs/migration-v1-to-v2.md"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gchigoo/repo-nav.git"
  },
  "bugs": {
    "url": "https://github.com/gchigoo/repo-nav/issues"
  },
  "homepage": "https://github.com/gchigoo/repo-nav#readme",
  "keywords": [
    "repository-navigation",
    "mcp",
    "code-search",
    "developer-tools"
  ],
  "scripts": {
    "clean": "node tools/release/clean-build-output.mjs",
    "build": "node tools/release/build-package-candidate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format:check": "prettier --check \"src/**/*.{ts,json,md,mjs}\" \"tools/**/*.{ts,mts,json,md,mjs,yaml,yml}\" \"scripts/**/*.{ts,mts,json,md,mjs,yaml,yml}\" \"test/**/*.{ts,json,md,mjs}\" \"testkit/**/*.{ts,json,md,mjs,yaml,yml}\" \".github/workflows/*.{yaml,yml}\" \"docs/**/*.md\" \"README.md\" \"SECURITY.md\" \"vitest*.config.ts\" \"*.{json,yaml,yml,mjs,ts}\" \".prettierrc.json\" --ignore-path .prettierignore",
    "test": "tsx testkit/runners/unit-runner.ts",
    "test:integration:codegraph": "vitest run --config vitest.integration-codegraph.config.ts",
    "test:golden": "tsx testkit/runners/golden-runner.ts",
    "test:mcp:built": "tsx testkit/runners/mcp-runner.ts",
    "test:mcp": "npm run build --silent && npm run test:mcp:built --",
    "test:docs:built": "tsx testkit/docs/docs-smoke-runner.ts",
    "test:docs": "npm run build --silent && npm run test:docs:built",
    "test:platform": "node --import tsx tools/ci/run-platform-contracts.mjs",
    "package:metadata:check": "node tools/release/check-package-metadata.mjs",
    "package:lock:check": "node tools/release/check-package-lock.mjs",
    "package:emit:check": "node tools/release/check-package-emit.mjs",
    "package:dry-run": "node tools/release/pack-candidate.mjs --dry-run",
    "package:smoke": "node tools/release/pack-candidate.mjs --smoke",
    "package:closure:check": "node tools/release/verify-installed-closure.mjs",
    "security:audit": "node tools/release/audit-installed-closure.mjs",
    "security:sbom:check": "node tools/release/verify-installed-sbom.mjs",
    "release:owner-actions:check": "node tools/release/check-owner-actions.mjs",
    "benchmark:fixture-scenarios": "tsx tools/benchmark/real-repo-benchmark-runner.ts",
    "benchmark:real-repos": "npm run benchmark:fixture-scenarios",
    "benchmark:quality-gate": "tsx tools/benchmark/real-repo-quality-gate.ts",
    "benchmark:snapshot-revalidation": "tsx tools/benchmark/snapshot-revalidation-benchmark.ts",
    "benchmark:snapshot-revalidation:clean-branch": "tsx tools/benchmark/snapshot-revalidation-clean-branch-probe.ts",
    "benchmark:snapshot-revalidation:import": "tsx tools/benchmark/import-snapshot-revalidation-candidate.ts",
    "benchmark:cli-cold-start": "node tools/benchmark/cli-cold-start.mjs",
    "repo-nav": "node dist/cli/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.1.28",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "globals": "^16.2.0",
    "npm": "11.12.1",
    "prettier": "3.9.6",
    "tsx": "4.23.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "overrides": {
    "fast-uri": "4.1.2",
    "ip-address": "10.4.0"
  }
}
